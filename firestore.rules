rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidMemberList(listVal) {
      return listVal is list && listVal.size() >= 1 && listVal.size() <= 200 && listVal[0] is string;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.roleTitle is string && data.roleTitle.size() >= 1 && data.roleTitle.size() <= 50 &&
             data.highContrastMode is bool &&
             data.darkMode is bool &&
             data.locationSharingEnabled is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isChannelMember(channelId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/channels/$(channelId)) &&
             request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.memberUids;
    }

    function isValidChannel(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             isValidMemberList(data.memberUids) &&
             (!('memberNames' in data) || (data.memberNames is map && data.memberNames.size() <= 200)) &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 60 &&
             data.topic is string && data.topic.size() <= 160 &&
             data.channelType in ['FIELD', 'PROJECT', 'LOGISTICS', 'GENERAL'] &&
             data.pinnedDocTitle is string && data.pinnedDocTitle.size() >= 1 && data.pinnedDocTitle.size() <= 100 &&
             data.pinnedDocBody is string && data.pinnedDocBody.size() <= 12000 &&
             data.pinnedDocUpdatedBy is string && data.pinnedDocUpdatedBy.size() >= 1 && data.pinnedDocUpdatedBy.size() <= 60 &&
             (!('pinnedDocRevision' in data) || (data.pinnedDocRevision is int && data.pinnedDocRevision >= 1)) &&
             (!('joinCode' in data) || data.joinCode == null || (data.joinCode is string && isValidId(data.joinCode))) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDocRevision(data, channelId) {
      return data.channelId == channelId &&
             data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.body is string && data.body.size() <= 12000 &&
             data.revisionNumber is int && data.revisionNumber >= 1 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidChannelInvite(data, inviteCode) {
      return data.inviteCode == inviteCode &&
             inviteCode.size() >= 6 && inviteCode.size() <= 16 &&
             inviteCode.matches('^[A-Z0-9]+$') &&
             data.channelId is string && isValidId(data.channelId) &&
             data.channelName is string && data.channelName.size() >= 2 && data.channelName.size() <= 60 &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('expiresAt' in data) || (data.expiresAt is timestamp && data.expiresAt > data.createdAt));
    }

    function isGoogleWorkspaceUrl(uri) {
      return uri is string &&
             uri.size() >= 24 &&
             uri.size() <= 500 &&
             uri.matches('^https://(docs|drive)\\.google\\.com/.*');
    }

    function isValidMessage(data, channelId) {
      return data.channelId == channelId &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
             isValidMemberList(data.memberUids) &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 2000 &&
             data.messageType in ['TEXT', 'GEO_PIN', 'PHOTO', 'DOC_LINK', 'SYSTEM'] &&
             (!('parentMessageId' in data) || (data.parentMessageId is string && isValidId(data.parentMessageId))) &&
             (!('linkedMarkerId' in data) || (data.linkedMarkerId is string && isValidId(data.linkedMarkerId))) &&
             (!('linkedMarkerTitle' in data) || (data.linkedMarkerTitle is string && data.linkedMarkerTitle.size() >= 1 && data.linkedMarkerTitle.size() <= 80)) &&
             (!('attachmentLabel' in data) || (data.attachmentLabel is string && data.attachmentLabel.size() >= 1 && data.attachmentLabel.size() <= 120)) &&
             (!('attachmentUri' in data) || isGoogleWorkspaceUrl(data.attachmentUri)) &&
             (!('attachmentSnippet' in data) || (data.attachmentSnippet is string && data.attachmentSnippet.size() >= 1 && data.attachmentSnippet.size() <= 500)) &&
             (!('attachmentData' in data) || (data.attachmentData is string && data.attachmentData.size() >= 1 && data.attachmentData.size() <= 350000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMarker(data, channelId) {
      return data.channelId == channelId &&
             data.creatorId is string && data.creatorId.size() >= 1 && data.creatorId.size() <= 128 &&
             data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 60 &&
             isValidMemberList(data.memberUids) &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 80 &&
             data.notes is string && data.notes.size() <= 1000 &&
             data.category in ['INCIDENT', 'PROGRESS', 'CHECKPOINT', 'DELIVERY', 'ROUTE'] &&
             data.status in ['OPEN', 'IN_PROGRESS', 'RESOLVED'] &&
             data.lat is number && data.lat >= -90 && data.lat <= 90 &&
             data.lng is number && data.lng >= -180 && data.lng <= 180 &&
             data.mapX is number && data.mapX >= 0 && data.mapX <= 1 &&
             data.mapY is number && data.mapY >= 0 && data.mapY <= 1 &&
             (!('linkedDocId' in data) || data.linkedDocId == null || isValidId(data.linkedDocId)) &&
             (!('linkedDocTitle' in data) || data.linkedDocTitle == null || (data.linkedDocTitle is string && data.linkedDocTitle.size() >= 1 && data.linkedDocTitle.size() <= 120)) &&
             (!('linkedDocUri' in data) || data.linkedDocUri == null || isGoogleWorkspaceUrl(data.linkedDocUri)) &&
             (!('linkedDocSnippet' in data) || data.linkedDocSnippet == null || (data.linkedDocSnippet is string && data.linkedDocSnippet.size() >= 1 && data.linkedDocSnippet.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPresence(data, channelId, userId) {
      return data.channelId == channelId &&
             data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             isValidMemberList(data.memberUids) &&
             data.sharingActive is bool &&
             data.lat is number && data.lat >= -90 && data.lat <= 90 &&
             data.lng is number && data.lng >= -180 && data.lng <= 180 &&
             data.mapX is number && data.mapX >= 0 && data.mapX <= 1 &&
             data.mapY is number && data.mapY >= 0 && data.mapY <= 1 &&
             data.accuracyMeters is number && data.accuracyMeters >= 0 && data.accuracyMeters <= 5000 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 1. User Preferences (strictly owner-scoped, zero cross-user PII exposure)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'roleTitle', 'highContrastMode', 'darkMode', 'locationSharingEnabled', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'roleTitle', 'highContrastMode', 'darkMode', 'locationSharingEnabled', 'createdAt', 'updatedAt']);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'roleTitle', 'highContrastMode', 'darkMode', 'locationSharingEnabled', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // 2. Channel Invite Codes (non-listable, exact code lookup only, with optional expiration)
    match /channel_invites/{inviteCode} {
      allow get: if isSignedIn() && isValidId(inviteCode);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(inviteCode) &&
                       isValidChannelInvite(incoming(), inviteCode) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().keys().hasAll(['inviteCode', 'channelId', 'channelName', 'ownerId', 'createdAt']) &&
                       incoming().keys().hasOnly(['inviteCode', 'channelId', 'channelName', 'ownerId', 'createdAt', 'expiresAt']) &&
                       exists(/databases/$(database)/documents/channels/$(incoming().channelId)) &&
                       get(/databases/$(database)/documents/channels/$(incoming().channelId)).data.ownerId == request.auth.uid;

      allow update: if false;
      allow delete: if isSignedIn() &&
                       isValidId(inviteCode) &&
                       (resource == null || existing().ownerId == request.auth.uid);
    }

    // 3. Operational Channels + Pinned Collaborative Doc
    match /channels/{channelId} {
      allow get: if isSignedIn() && isValidId(channelId) && request.auth.uid in existing().memberUids;
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if isSignedIn() &&
                       isValidId(channelId) &&
                       isValidChannel(incoming()) &&
                       incoming().ownerId == request.auth.uid &&
                       request.auth.uid in incoming().memberUids &&
                       incoming().keys().hasAll(['ownerId', 'memberUids', 'name', 'topic', 'channelType', 'pinnedDocTitle', 'pinnedDocBody', 'pinnedDocUpdatedBy', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerId', 'memberUids', 'memberNames', 'name', 'topic', 'channelType', 'pinnedDocTitle', 'pinnedDocBody', 'pinnedDocUpdatedBy', 'pinnedDocRevision', 'joinCode', 'createdAt', 'updatedAt']);

      allow update: if isSignedIn() &&
                       isValidId(channelId) &&
                       isValidChannel(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (request.auth.uid in existing().memberUids &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['pinnedDocTitle', 'pinnedDocBody', 'pinnedDocUpdatedBy', 'pinnedDocRevision', 'updatedAt']) &&
                          incoming().memberUids == existing().memberUids) ||
                         (existing().ownerId == request.auth.uid &&
                          request.auth.uid in incoming().memberUids &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'topic', 'channelType', 'memberUids', 'memberNames', 'joinCode', 'updatedAt'])) ||
                         (request.auth.uid in existing().memberUids &&
                          existing().ownerId != request.auth.uid &&
                          !(request.auth.uid in incoming().memberUids) &&
                          existing().memberUids.hasAll(incoming().memberUids) &&
                          incoming().memberUids.size() == existing().memberUids.size() - 1 &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'memberNames', 'updatedAt']) &&
                          (!('memberNames' in existing()) || !('memberNames' in incoming()) || incoming().memberNames.diff(existing().memberNames).affectedKeys().hasOnly([request.auth.uid]))) ||
                         (!(request.auth.uid in existing().memberUids) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'memberNames', 'joinCode', 'updatedAt']) &&
                          incoming().memberUids.hasAll(existing().memberUids) &&
                          incoming().memberUids.size() == existing().memberUids.size() + 1 &&
                          request.auth.uid in incoming().memberUids &&
                          (!('memberNames' in incoming()) ||
                           (request.auth.uid in incoming().memberNames &&
                            incoming().memberNames[request.auth.uid] is string &&
                            incoming().memberNames[request.auth.uid].size() >= 1 &&
                            incoming().memberNames[request.auth.uid].size() <= 60 &&
                            ((!('memberNames' in existing()) && incoming().memberNames.keys().hasOnly([request.auth.uid])) ||
                             ('memberNames' in existing() && incoming().memberNames.diff(existing().memberNames).affectedKeys().hasOnly([request.auth.uid]))))) &&
                          (!('pinnedDocRevision' in existing()) || incoming().pinnedDocRevision == existing().pinnedDocRevision) &&
                          incoming().pinnedDocTitle == existing().pinnedDocTitle &&
                          incoming().pinnedDocBody == existing().pinnedDocBody &&
                          incoming().pinnedDocUpdatedBy == existing().pinnedDocUpdatedBy &&
                          incoming().name == existing().name &&
                          incoming().topic == existing().topic &&
                          incoming().channelType == existing().channelType &&
                          incoming().joinCode is string &&
                          isValidId(incoming().joinCode) &&
                          exists(/databases/$(database)/documents/channel_invites/$(incoming().joinCode)) &&
                          get(/databases/$(database)/documents/channel_invites/$(incoming().joinCode)).data.channelId == channelId &&
                          (!('expiresAt' in get(/databases/$(database)/documents/channel_invites/$(incoming().joinCode)).data) ||
                           request.time <= get(/databases/$(database)/documents/channel_invites/$(incoming().joinCode)).data.expiresAt))
                       );

      allow delete: if isSignedIn() && isValidId(channelId) && existing().ownerId == request.auth.uid;

      // 4. Messages & Threads (strictly gated by live channel membership)
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(channelId) && isValidId(messageId) && isChannelMember(channelId);
        allow list: if isSignedIn() && isValidId(channelId) && isChannelMember(channelId);

        allow create: if isSignedIn() &&
                         isValidId(channelId) &&
                         isValidId(messageId) &&
                         isValidMessage(incoming(), channelId) &&
                         incoming().senderId == request.auth.uid &&
                         request.auth.uid in incoming().memberUids &&
                         incoming().keys().hasAll(['channelId', 'senderId', 'senderName', 'memberUids', 'body', 'messageType', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['channelId', 'senderId', 'senderName', 'memberUids', 'body', 'parentMessageId', 'linkedMarkerId', 'linkedMarkerTitle', 'attachmentLabel', 'attachmentUri', 'attachmentSnippet', 'attachmentData', 'messageType', 'createdAt', 'updatedAt']) &&
                         isChannelMember(channelId);

        allow update: if isSignedIn() &&
                         isValidId(channelId) &&
                         isValidId(messageId) &&
                         isChannelMember(channelId) &&
                         isValidMessage(incoming(), channelId) &&
                         existing().senderId == request.auth.uid &&
                         incoming().senderId == existing().senderId &&
                         incoming().channelId == existing().channelId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().memberUids == existing().memberUids &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['body', 'updatedAt']);

        allow delete: if isSignedIn() &&
                         isValidId(channelId) &&
                         isValidId(messageId) &&
                         isChannelMember(channelId) &&
                         existing().senderId == request.auth.uid;
      }

      // 5. Shared GeoMarkers & Point Notes (strictly gated by live channel membership)
      match /markers/{markerId} {
        allow get: if isSignedIn() && isValidId(channelId) && isValidId(markerId) && isChannelMember(channelId);
        allow list: if isSignedIn() && isValidId(channelId) && isChannelMember(channelId);

        allow create: if isSignedIn() &&
                         isValidId(channelId) &&
                         isValidId(markerId) &&
                         isValidMarker(incoming(), channelId) &&
                         incoming().creatorId == request.auth.uid &&
                         request.auth.uid in incoming().memberUids &&
                         incoming().keys().hasAll(['channelId', 'creatorId', 'updatedByName', 'memberUids', 'title', 'notes', 'category', 'status', 'lat', 'lng', 'mapX', 'mapY', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['channelId', 'creatorId', 'updatedByName', 'memberUids', 'title', 'notes', 'category', 'status', 'lat', 'lng', 'mapX', 'mapY', 'linkedDocId', 'linkedDocTitle', 'linkedDocUri', 'linkedDocSnippet', 'createdAt', 'updatedAt']) &&
                         isChannelMember(channelId);

        allow update: if isSignedIn() &&
                         isValidId(channelId) &&
                         isValidId(markerId) &&
                         isChannelMember(channelId) &&
                         isValidMarker(incoming(), channelId) &&
                         incoming().creatorId == existing().creatorId &&
                         incoming().channelId == existing().channelId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().memberUids == existing().memberUids &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'notes', 'category', 'status', 'lat', 'lng', 'mapX', 'mapY', 'linkedDocId', 'linkedDocTitle', 'linkedDocUri', 'linkedDocSnippet', 'updatedByName', 'updatedAt']);

        allow delete: if isSignedIn() &&
                         isValidId(channelId) &&
                         isValidId(markerId) &&
                         isChannelMember(channelId) &&
                         (existing().creatorId == request.auth.uid ||
                          get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid);
      }

      // 6. Opt-in Live Location Presence (no PII, strictly gated by live channel membership)
      match /presence/{userId} {
        allow get: if isSignedIn() && isValidId(channelId) && isValidId(userId) && isChannelMember(channelId);
        allow list: if isSignedIn() && isValidId(channelId) && isChannelMember(channelId);

        allow create: if isOwner(userId) &&
                         isValidId(channelId) &&
                         isValidId(userId) &&
                         isChannelMember(channelId) &&
                         isValidPresence(incoming(), channelId, userId) &&
                         request.auth.uid in incoming().memberUids &&
                         incoming().keys().hasAll(['channelId', 'userId', 'displayName', 'memberUids', 'sharingActive', 'lat', 'lng', 'mapX', 'mapY', 'accuracyMeters', 'updatedAt']) &&
                         incoming().keys().hasOnly(['channelId', 'userId', 'displayName', 'memberUids', 'sharingActive', 'lat', 'lng', 'mapX', 'mapY', 'accuracyMeters', 'updatedAt']);

        allow update: if isOwner(userId) &&
                         isValidId(channelId) &&
                         isValidId(userId) &&
                         isChannelMember(channelId) &&
                         isValidPresence(incoming(), channelId, userId) &&
                         incoming().userId == existing().userId &&
                         incoming().channelId == existing().channelId &&
                         incoming().memberUids == existing().memberUids &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'sharingActive', 'lat', 'lng', 'mapX', 'mapY', 'accuracyMeters', 'updatedAt']);

        allow delete: if isOwner(userId) &&
                         isValidId(channelId) &&
                         isValidId(userId) &&
                         isChannelMember(channelId);
      }

      // 7. Immutable Bitacora Revision History
      match /doc_revisions/{revisionId} {
        allow get: if isSignedIn() && isValidId(channelId) && isValidId(revisionId) && isChannelMember(channelId);
        allow list: if isSignedIn() && isValidId(channelId) && isChannelMember(channelId);

        allow create: if isSignedIn() &&
                         isValidId(channelId) &&
                         isValidId(revisionId) &&
                         isValidDocRevision(incoming(), channelId) &&
                         incoming().authorId == request.auth.uid &&
                         incoming().keys().hasAll(['channelId', 'authorId', 'authorName', 'title', 'body', 'revisionNumber', 'createdAt']) &&
                         incoming().keys().hasOnly(['channelId', 'authorId', 'authorName', 'title', 'body', 'revisionNumber', 'createdAt']) &&
                         isChannelMember(channelId);

        allow update, delete: if false;
      }
    }
  }
}
